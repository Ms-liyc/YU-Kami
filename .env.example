# YU-Kami 环境变量示例（复制为 .env 或在 docker-compose / 系统中配置）

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yukami
DB_USER=root
DB_PASSWORD=your-db-password

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 安全密钥（生产环境务必修改！）----------
JWT_SECRET=change-me-to-a-long-random-string
HMAC_SECRET=change-me-hmac-secret
AES_KEY=change-me-32-char-aes-key!!!!!!

# ---------- 安全策略（生产环境建议配置）----------
# 逗号分隔的前端域名；设为 * 则允许任意来源（不携带 Cookie 凭证）
# CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
# 生产环境关闭 Swagger UI
# SWAGGER_ENABLED=false
# 登录/注册速率限制（次/分钟/IP）
# LOGIN_RATE_LIMIT=20
# REGISTER_RATE_LIMIT=5

# ---------- 验证码 / 邮件 / 应用 URL（v1.15+）----------
# CAPTCHA_ENABLED=true
# APP_URL=https://your-domain.com

# QQ 邮箱 SMTP（需在 QQ 邮箱设置中开启 SMTP 并获取 16 位授权码，见 docs/MAIL.md）
# ⚠️ 切勿将真实 .env 提交到 Git；MAIL_PASSWORD 为授权码，不是 QQ 登录密码
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_SSL=true
# MAIL_STARTTLS=false
# MAIL_USERNAME=123456789@qq.com
# MAIL_PASSWORD=你的16位授权码
# MAIL_FROM=123456789@qq.com

# ---------- 短信通知（见 docs/SMS.md）----------
# SMS_PROVIDER=none
# STOCK_ALERT_PHONE=13800138000
# HTTP 网关（推荐）
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://your-gateway.example.com/sms/send
# SMS_HTTP_SECRET=your-shared-secret
# 阿里云短信
# SMS_PROVIDER=aliyun
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# SMS_ALIYUN_SIGN_NAME=
# SMS_ALIYUN_TEMPLATE_CODE=

# ---------- 库存告警 ----------
# STOCK_LOW_THRESHOLD=10
# STOCK_ALERT_EMAIL=ops@example.com,admin@example.com

# ---------- 支付对接（可选，按实际部署环境填写）----------
# PAYMENT_BASE_URL=https://your-domain.com
# PAYMENT_RETURN_URL=https://your-domain.com/shop/orders
# 生产环境务必关闭模拟支付
# MOCK_PAYMENT_ENABLED=false
