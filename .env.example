# YU-Kami 环境变量示例（复制为 .env 或在 docker-compose / 系统中配置）

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yukami
DB_USER=yukami
DB_PASSWORD=yukami123

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 安全密钥（生产环境务必修改！）----------
JWT_SECRET=change-me-to-a-long-random-string
HMAC_SECRET=change-me-hmac-secret
AES_KEY=change-me-32-char-aes-key!!!!!!

# ---------- 支付对接（可选，按实际部署环境填写）----------
# PAYMENT_BASE_URL=https://your-domain.com
# PAYMENT_RETURN_URL=https://your-domain.com/shop/orders
