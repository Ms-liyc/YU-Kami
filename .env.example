# YU-Kami 环境变量示例（复制为 .env 或在 docker-compose / 系统中配置）

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yukami
DB_USER=root
DB_PASSWORD=your-db-password

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 安全密钥（生产环境务必修改！）----------
JWT_SECRET=change-me-to-a-long-random-string
HMAC_SECRET=change-me-hmac-secret
AES_KEY=change-me-32-char-aes-key!!!!!!

# ---------- 安全策略（生产环境建议配置）----------
# 逗号分隔的前端域名；设为 * 则允许任意来源（不携带 Cookie 凭证）
# CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
# 生产环境关闭 Swagger UI
# SWAGGER_ENABLED=false
# 登录/注册速率限制（次/分钟/IP）
# LOGIN_RATE_LIMIT=20
# REGISTER_RATE_LIMIT=5

# ---------- 验证码 / 邮件 / 应用 URL（v1.15+）----------
# CAPTCHA_ENABLED=true
# APP_URL=https://your-domain.com
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your@example.com
# MAIL_PASSWORD=your-smtp-password
# MAIL_FROM=noreply@example.com

# ---------- 库存告警 ----------
# STOCK_LOW_THRESHOLD=10
# STOCK_ALERT_EMAIL=ops@example.com,admin@example.com

# ---------- 支付对接（可选，按实际部署环境填写）----------
# PAYMENT_BASE_URL=https://your-domain.com
# PAYMENT_RETURN_URL=https://your-domain.com/shop/orders
